---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-5", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mb-4
       w-24 h-24 overflow-hidden rounded-full ring-1 ring-black/10 dark:ring-white/15 shadow-sm active:scale-95 transition-transform"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/35 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-2xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      fadeIn={false}
      widths={[192, 350]}
      sizes="96px"
    />
  </a>
  <div class="px-1 text-center">
    <div class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-neutral-400 dark:text-neutral-500 mb-1">
      Author
    </div>
    <div
      class="font-bold text-lg tracking-tight text-neutral-900 dark:text-neutral-50 mb-1.5 transition"
    >
      {profileConfig.name}
    </div>
    <div class="text-center text-xs leading-relaxed text-neutral-500 dark:text-neutral-400 mb-4 transition">
      {profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-2 justify-center">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-full h-9 gap-2 px-3.5 text-xs font-semibold active:scale-95" 
                        : "btn-regular rounded-full h-9 w-9 active:scale-90";

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.15rem]"></Icon>
                            {showName && item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
                            <Icon name={item.icon} class="text-[1.15rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class="btn-regular rounded-full h-9 gap-2 px-3.5 text-xs font-semibold active:scale-95">
                            <Icon name={item.icon} class="text-[1.15rem]"></Icon>
                            {item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                            class="btn-regular rounded-full h-9 gap-2 px-3.5 text-xs font-semibold active:scale-95">
                                <Icon name={item.icon} class="text-[1.15rem]"></Icon>
                                {item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
  </div>
</div>
